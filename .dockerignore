# Dependencies and build output are recreated inside the multi-stage image.
node_modules/
dist/

# Version-control, logs, editor state, and local configuration.
.git/
.manus-logs/
.env
.env.*
!.env.example
*.log

# Model-training and generated model artifacts are mounted or shipped separately;
# they must never be copied into the application image build context.
ml/
deploy/on-prem/models/
deploy/on-prem/*.backup
deploy/on-prem/*.pre-minio-*

# Generated and local-only files.
coverage/
tmp/
*.tar.gz
*.zip
__pycache__/
*.pyc
