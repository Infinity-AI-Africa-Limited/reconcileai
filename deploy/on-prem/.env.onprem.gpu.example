# ReconcileAI — private Qwen/vLLM GPU serving profile
# Copy to .env.onprem only on an approved, institution-controlled GPU host.
# Never commit the populated file. Keep developer laptops on docker-compose.cpu.yml.
#
# Validate before starting:
#   pnpm onprem:preflight -- --profile gpu --env-file .env.onprem
#
# This file is the Compose interpolation source. It is NOT loaded into the
# application container — the compose file enumerates the app's environment.

# ── Required secrets — generate a unique value per deployment ────────────────
# openssl rand -hex 32
JWT_SECRET=replace-with-a-64-char-random-secret
MYSQL_ROOT_PASSWORD=replace-with-a-strong-database-password

# vLLM request authentication. Store this in the institution's secret manager.
# It is shared only by the ReconcileAI app and the private in-stack vLLM service,
# and is passed to vLLM as an environment variable so it never enters argv.
VLLM_API_KEY=replace-with-a-deployment-specific-random-secret

# ── Private S3-compatible storage ────────────────────────────────────────────
# Same contract as the CPU profile: root administers MinIO, the app holds only
# a bucket-scoped service account that storage-init creates and verifies.
MINIO_ROOT_USER=reconcileai-storage-admin
MINIO_ROOT_PASSWORD=replace-with-a-strong-storage-root-password
MINIO_APP_ACCESS_KEY=reconcileai-app
MINIO_APP_SECRET_KEY=replace-with-a-strong-storage-app-password
AWS_S3_BUCKET=reconcileai
AWS_REGION=us-east-1

# ── Approved Qwen artifact ───────────────────────────────────────────────────
# Use the exact immutable revision reviewed through the institution's
# model-supply-chain process; never an unreviewed floating tag or branch name.
# Pre-stage the weights in the hf-cache volume: HF_HUB_OFFLINE=1 means vLLM will
# not reach the internet for them at start-up.
RECON_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# Must be the 40-character commit SHA. A tag or branch is a mutable pointer and
# is rejected by both the preflight and the start-up gate.
MODEL_REVISION=replace-with-the-40-char-commit-sha-the-institution-approved
HF_HUB_OFFLINE=1

# ── Container images — pinned by digest, never by a floating tag ─────────────
# Real digests resolved on 2026-08-16, supplied as a working reference. Replace
# with the digests the institution itself scanned and approved.
MYSQL_IMAGE=mysql@sha256:7dcddc01f13bab2f15cde676d44d01f61fc9f99fe7785e86196dfc07d358ae2b
MINIO_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
MINIO_MC_IMAGE=minio/mc@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727
NGINX_IMAGE=nginx@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
# vllm/vllm-openai:v0.11.0
VLLM_IMAGE=vllm/vllm-openai@sha256:014a95f21c9edf6abe0aea6b07353f96baa4ec291c427bb1176dc7c93a85845c

# ── Serving capacity. Tune only with documented capacity-test evidence. ──────
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_GPU_COUNT=1
VLLM_SHM_SIZE=8gb

# ── Exposure ─────────────────────────────────────────────────────────────────
# The stack publishes ONE port: the nginx gateway on host loopback. A
# bank-approved reverse proxy handles TLS, identity, authorisation, rate limits
# and audit policy before forwarding to it.
APP_BIND_ADDRESS=127.0.0.1
APP_URL=https://reconcile.bank.internal

# ── Optional internal data source. Leave blank for file-only ingestion. ──────
WOODCORE_DB_HOST=
WOODCORE_DB_PORT=3306
WOODCORE_DB_USER=
WOODCORE_DB_PASSWORD=
WOODCORE_DB_NAME=
