# ReconcileAI — private Qwen/vLLM GPU serving profile
# Copy to .env.onprem only on an approved, institution-controlled GPU host.
# Never commit the populated file. Keep developer laptops on docker-compose.cpu.yml.

# Required application and database secrets. Generate unique values per deployment.
JWT_SECRET=replace-with-a-64-char-random-secret
MYSQL_ROOT_PASSWORD=replace-with-a-strong-database-password

# vLLM request authentication. Store this in the institution's secret manager.
# It is shared only by the ReconcileAI app and the private in-stack vLLM service.
VLLM_API_KEY=replace-with-a-deployment-specific-random-secret

# Approved Qwen artifact. Use the exact immutable revision reviewed through the
# institution's model-supply-chain process; do not use an unreviewed floating tag.
RECON_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
MODEL_REVISION=replace-with-reviewed-immutable-model-revision

# Pin the serving image by digest in a production package after vulnerability scan.
VLLM_IMAGE=vllm/vllm-openai:latest

# Conservative defaults. Tune only with documented capacity-test evidence.
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.85

# The app binds to host loopback only. A bank-approved reverse proxy should handle
# TLS, identity, authorisation, rate limits and audit policy before forwarding here.
APP_BIND_ADDRESS=127.0.0.1
APP_URL=https://reconcile.bank.internal

# The app has a read-only, in-network data access posture. Leave blank for file
# ingestion or set only to the bank's approved internal data source.
WOODCORE_DB_HOST=
WOODCORE_DB_PORT=3306
WOODCORE_DB_USER=
WOODCORE_DB_PASSWORD=
WOODCORE_DB_NAME=
