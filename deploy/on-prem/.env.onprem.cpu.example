# ReconcileAI — private CPU/Ollama serving profile for institutions without GPUs
# Copy to .env.onprem on the institution-controlled host. Never commit the filled file.

JWT_SECRET=replace-with-a-64-char-random-secret
MYSQL_ROOT_PASSWORD=replace-with-a-strong-database-password

# Development/demo mode only: downloads the stock model before an air-gap is applied.
# OLLAMA_MODEL_MODE=pull
# RECON_MODEL=qwen2.5:3b-instruct-q4_K_M

# Bank deployment mode: ship a verified deployment package containing
# models/reconcileai-recon-3b-q4_k_m.gguf and models/SHA256SUMS. The Compose
# bootstrap refuses to import if the shipped artifact does not match the manifest.
# Independently compare that manifest's digest with the signed release record before
# the package enters the institution.
OLLAMA_MODEL_MODE=import
RECON_MODEL=reconcileai

# Pin this to a scanned image digest in the bank delivery package.
OLLAMA_IMAGE=ollama/ollama:latest

# The application is loopback-only. The bank reverse proxy supplies TLS, identity,
# access control, rate limits and audit policy before forwarding to the app.
APP_BIND_ADDRESS=127.0.0.1
APP_URL=https://reconcile.bank.internal

# Optional internal data-source settings. Leave blank for file-only ingestion.
WOODCORE_DB_HOST=
WOODCORE_DB_PORT=3306
WOODCORE_DB_USER=
WOODCORE_DB_PASSWORD=
WOODCORE_DB_NAME=
