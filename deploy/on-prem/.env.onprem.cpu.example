# ReconcileAI — private CPU/Ollama serving profile for institutions without GPUs
# Copy to .env.onprem on the institution-controlled host. Never commit the filled file.
#
# Validate before starting:
#   pnpm onprem:preflight -- --profile cpu --env-file .env.onprem
#
# This file is the Compose interpolation source. It is NOT loaded into the
# application container: the compose file enumerates the app's environment
# explicitly so infrastructure secrets (MinIO root, image digests) stay out of
# the web app's process environment.

# ── Required secrets — generate a unique value per deployment ────────────────
# openssl rand -hex 32
JWT_SECRET=replace-with-a-64-char-random-secret
MYSQL_ROOT_PASSWORD=replace-with-a-strong-database-password

# ── Private S3-compatible storage (bundled with this CPU profile) ────────────
# Root credentials administer MinIO and are held ONLY by the minio and
# storage-init services. The application authenticates with the bucket-scoped
# service account below, which storage-init creates and then verifies.
MINIO_ROOT_USER=reconcileai-storage-admin
MINIO_ROOT_PASSWORD=replace-with-a-strong-storage-root-password
MINIO_APP_ACCESS_KEY=reconcileai-app
MINIO_APP_SECRET_KEY=replace-with-a-strong-storage-app-password
AWS_S3_BUCKET=reconcileai
AWS_REGION=us-east-1

# ── Container images — pinned by digest, never by a floating tag ─────────────
# A tag can be repointed at different bytes after the institution scans it; a
# digest cannot. The values below are the real digests these tags resolved to on
# 2026-08-16 and are supplied as a working reference. Replace them with the
# digests the institution itself scanned and approved for the delivery package.
MYSQL_IMAGE=mysql@sha256:7dcddc01f13bab2f15cde676d44d01f61fc9f99fe7785e86196dfc07d358ae2b
MINIO_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
MINIO_MC_IMAGE=minio/mc@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727
OLLAMA_IMAGE=ollama/ollama@sha256:77f1a2a54460f0380f2611e1464233d9b82cb6e58afc8f60abec0061049d2d82
NGINX_IMAGE=nginx@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

# ── Model bootstrap ──────────────────────────────────────────────────────────
# Bank deployment: ship a verified package containing
#   models/<RECON_MODEL_FILE>  and  models/SHA256SUMS  and  models/Modelfile
# The bootstrap checks the artifact twice before importing it:
#   1. against the shipped SHA256SUMS  (transfer integrity)
#   2. against RECON_MODEL_SHA256      (authenticity)
# RECON_MODEL_SHA256 must come from the signed release record over a DIFFERENT
# path than the media itself. A manifest carried alongside the artifact cannot
# authorise its own import — whoever can swap the GGUF can rewrite the manifest.
OLLAMA_MODEL_MODE=import
RECON_MODEL=reconcileai
RECON_MODEL_FILE=reconcileai-recon-3b-q4_k_m.gguf
RECON_MODEL_SHA256=replace-with-the-gguf-digest-from-the-signed-release-record
RECON_MODELFILE_SHA256=replace-with-the-modelfile-digest-from-the-signed-release-record

# Development/demo only — pulls a stock model from the internet before an
# air-gap is applied. Never use this path for an institution deployment.
#   OLLAMA_MODEL_MODE=pull
#   RECON_MODEL=qwen2.5:3b-instruct-q4_K_M
#   (RECON_MODEL_SHA256 is not required in pull mode.)

# ── Exposure ─────────────────────────────────────────────────────────────────
# The stack publishes ONE port: the nginx gateway on host loopback. The bank
# reverse proxy supplies TLS, identity, access control, rate limits and audit
# policy before forwarding to it.
APP_BIND_ADDRESS=127.0.0.1
APP_URL=https://reconcile.bank.internal

# ── Optional internal data source. Leave blank for file-only ingestion. ──────
WOODCORE_DB_HOST=
WOODCORE_DB_PORT=3306
WOODCORE_DB_USER=
WOODCORE_DB_PASSWORD=
WOODCORE_DB_NAME=
