# ─────────────────────────────────────────────────────────────────────────────
# ReconcileAI — on-premise environment (Option 3: fully local, air-gapped)
# Copy to `.env.onprem` and fill in. NEVER commit the filled-in copy.
#
# The docker-compose files set the LLM + egress + database variables for you,
# so the only things you MUST set here are the two secrets at the top.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required secrets ─────────────────────────────────────────────────────────
# 64-char random string — signs login sessions. Generate with:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-char-random-string

# Database root password used by the bundled MySQL service.
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password

# ── Model selection (overridable; sensible defaults are in the compose files) ─
# CPU stack (Ollama): a small quantized instruct model that runs without a GPU.
#   Day-1 (no training):     qwen2.5:3b-instruct-q4_K_M
#   After fine-tuning:       reconcileai            (your imported Ollama model)
# GPU stack (vLLM):
#   Day-1 (no training):     Qwen/Qwen2.5-7B-Instruct
#   After fine-tuning:       reconcileai            (served-model-name)
RECON_MODEL=qwen2.5:3b-instruct-q4_K_M

# ── App URL (used to build magic-link sign-in URLs) ──────────────────────────
APP_URL=http://localhost:3000

# ── Optional: data ingestion source for the bank's Fineract/Woodcore tenant ──
# In on-premise mode these stay inside the bank's network. Leave blank if the
# bank uploads files instead of a live DB connection.
WOODCORE_DB_HOST=
WOODCORE_DB_PORT=3306
WOODCORE_DB_USER=
WOODCORE_DB_PASSWORD=
WOODCORE_DB_NAME=

# ── Email (optional; off by default in on-prem) ──────────────────────────────
# If the bank has an internal SMTP relay you may allowlist it (see compose).
# Without these, all email is a safe no-op (logged, never throws).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=ReconcileAI

# NOTE: DEPLOYMENT_MODE, DATABASE_URL, DIRECT_LLM_*, and EGRESS_ALLOWLIST are set
# by the docker-compose file you run — you do not need to set them here.
