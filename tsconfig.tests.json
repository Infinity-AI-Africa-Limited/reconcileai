{
  // Test files that MUST type-check, enforced in CI by `pnpm check:tests`.
  //
  // tsconfig.json excludes every *.test.ts, so until this file no test was
  // type-checked at all: a fixture typed `any`, or a fixture of the wrong
  // shape, passed CI and was caught only in review (#150, #151 — follow-up
  // #157). Switching the exclusion off surfaces dozens of errors in older
  // tests, so tests join this list one at a time as they are made clean.
  // The list only grows.
  //
  // "files", not "include": a listed file that is renamed or deleted fails
  // the check (TS6053) instead of silently dropping out of it. "include" is
  // emptied so the base config's source globs are not checked a second time.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false
  },
  "include": [],
  "files": [
    "client/src/lib/shopifyAppBridge.test.ts",
    "client/src/lib/shopifyOrderSyncProgress.test.ts",
    "client/src/lib/shopifySettlementMapping.test.ts",
    "server/appOrigin.test.ts",
    "server/connectors/shopify/appHomeRoutes.test.ts",
    "server/connectors/shopify/channelCodes.test.ts",
    "server/connectors/shopify/embeddedAuth.test.ts",
    "server/connectors/shopify/logSafety.test.ts",
    "server/connectors/shopify/manualSync.test.ts",
    "server/connectors/shopify/manualSyncQueue.redis.test.ts",
    "server/connectors/shopify/onboarding.test.ts",
    "server/connectors/shopify/orderBackstop.test.ts",
    "server/connectors/shopify/scriptedDb.testkit.test.ts",
    "server/connectors/shopify/settlementEvidence.test.ts",
    "server/connectors/shopify/syncCursor.db.test.ts",
    "server/connectors/shopify/webhookBody.test.ts",
    "server/connectors/shopline/settlementEvents.test.ts",
    "server/connectors/shopline/settlementFileDedupe.test.ts",
    "server/dbErrors.test.ts",
    "server/deactivatedAccess.test.ts",
    "server/jobQueue.coalesce.test.ts",
    "server/jobQueue.replaceFailed.test.ts",
    "server/reviewerLinkOrigin.test.ts",
    "server/routers/shopifyAppHome.test.ts",
    "server/sanitizeRef.test.ts",
    "server/sessionCookie.test.ts",
    "server/shoplineCallbackUrl.test.ts",
    "server/ssoFlowCookie.test.ts"
  ]
}
